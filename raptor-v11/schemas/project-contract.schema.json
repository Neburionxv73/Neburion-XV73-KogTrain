{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Raptor Delta V11 Project Contract",
  "type": "object",
  "required": ["project_id","version","scope","risk_profile","data_class","roles","required_gates","release_policy","recovery"],
  "properties": {
    "project_id": {"type":"string","minLength":1},
    "version": {"type":"string","minLength":1},
    "scope": {"type":"string","minLength":1},
    "risk_profile": {"enum":["LOW","STANDARD","HIGH","CRITICAL"]},
    "data_class": {"enum":["PUBLIC","INTERNAL","CONFIDENTIAL","RESTRICTED"]},
    "roles": {"type":"array","minItems":2,"items":{"type":"string"}},
    "required_gates": {"type":"array","minItems":1,"items":{"type":"string"}},
    "release_policy": {"type":"string","minLength":1},
    "recovery": {"type":"object","required":["rollback","incident_flow"],"properties":{"rollback":{"type":"boolean"},"incident_flow":{"type":"boolean"}}}
  }
}
